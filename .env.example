# Kalshi. Defaults to the demo exchange; see src/predmark/execution/kalshi.py for live arming.
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# Optional: higher limits for the literature harvest (`uv run --env-file .env python scripts/lit.py harvest`).
# Semantic Scholar works without a key, but its shared public pool is often throttled (HTTP 429).
# A free key from semanticscholar.org/product/api gives the harvest its own limit.
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# Optional: TypeSafe's Jev model (src/predmark/jev.py). Early access from console.typesafe.ai.
TYPESAFE_API_KEY=
